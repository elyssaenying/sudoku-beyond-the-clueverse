  <worksheets>
    <worksheet name='Catalogue concentration'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#172b4d' fontsize='13'>Most puzzles sit between 23 and 26 clues</run>
            <run fontcolor='#5e6c84' fontsize='9'>&#10;Core range 21–28, covering 99.98% of the catalogue</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Sudoku Difficulty' name='SudokuData' />
          </datasources>
          <datasource-dependencies datasource='SudokuData'>
            <column caption='Clue count' datatype='integer' name='[clues]' role='dimension' type='ordinal' />
            <column-instance column='[clues]' derivation='None' name='[none:clues:ok]' pivot='key' type='ordinal' />
            <column caption='Puzzles' datatype='integer' name='[puzzle_count]' role='measure' type='quantitative' />
            <column-instance column='[puzzle_count]' derivation='Sum' name='[sum:puzzle_count:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='axis'>
            <format attr='title' class='0' field='[SudokuData].[sum:puzzle_count:qk]' scope='rows' value='Number of puzzles' />
            <format attr='title' class='0' field='[SudokuData].[none:clues:ok]' scope='cols' value='Number of clues' />
          </style-rule>
          <style-rule element='worksheet'>
            <format attr='display-field-labels' scope='rows' value='false' />
            <format attr='display-field-labels' scope='cols' value='false' />
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option='selection-relaxation-disallow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Bar' />
            <style>
              <style-rule element='mark'>
                <format attr='color' value='#0052CC' />
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows>[SudokuData].[sum:puzzle_count:qk]</rows>
        <cols>[SudokuData].[none:clues:ok]</cols>
      </table>
      <simple-id uuid='{9DCCE773-3C1C-483D-B977-5B1F60E2B782}' />
    </worksheet>
    <worksheet name='Difficulty spread by clues'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#172b4d' fontsize='13'>Difficulty remains mixed inside the same clue count</run>
            <run fontcolor='#5e6c84' fontsize='9'>
P90 − P10 rating gap; clue counts 21–28 only (each has at least 5,000 puzzles)</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Sudoku Difficulty' name='SudokuData' />
          </datasources>
          <datasource-dependencies datasource='SudokuData'>
            <column-instance column='[central_80_range]' derivation='Avg' name='[avg:central_80_range:qk]' pivot='key' type='quantitative' />
            <column caption='Central 80% difficulty spread' datatype='real' name='[central_80_range]' role='measure' type='quantitative' />
            <column caption='Clue count' datatype='integer' name='[clues]' role='dimension' type='ordinal' />
            <column-instance column='[clues]' derivation='None' name='[none:clues:ok]' pivot='key' type='ordinal' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='axis'>
            <format attr='title' class='0' field='[SudokuData].[avg:central_80_range:qk]' scope='rows' value='Difficulty spread (P90 − P10)' />
            <format attr='title' class='0' field='[SudokuData].[none:clues:ok]' scope='cols' value='Number of clues' />
          </style-rule>
          <style-rule element='cell'>
            <format attr='text-format' field='[SudokuData].[avg:central_80_range:qk]' value='*0.0' />
          </style-rule>
          <style-rule element='label'>
            <format attr='font-size' value='9' />
            <format attr='color' value='#42526E' />
          </style-rule>
          <style-rule element='worksheet'>
            <format attr='display-field-labels' scope='rows' value='false' />
            <format attr='display-field-labels' scope='cols' value='false' />
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option='selection-relaxation-disallow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Bar' />
            <encodings>
              <text column='[SudokuData].[avg:central_80_range:qk]' />
            </encodings>
            <style>
              <style-rule element='mark'>
                <format attr='color' value='#FF8B00' />
                <format attr='mark-labels-show' value='true' />
                <format attr='mark-labels-cull' value='true' />
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows>[SudokuData].[avg:central_80_range:qk]</rows>
        <cols>[SudokuData].[none:clues:ok]</cols>
      </table>
      <simple-id uuid='{87A97B5C-E846-4D63-A029-49E1AE2B6CC6}' />
    </worksheet>
    <worksheet name='Scanning-only share'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#172b4d' fontsize='13'>More clues do not create a clean difficulty ladder</run>
            <run fontcolor='#5e6c84' fontsize='9'>
Scanning-only share; clue counts 21–28 only</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Sudoku Difficulty' name='SudokuData' />
          </datasources>
          <datasource-dependencies datasource='SudokuData'>
            <column-instance column='[scanning_only_share]' derivation='Avg' name='[avg:scanning_only_share:qk]' pivot='key' type='quantitative' />
            <column caption='Clue count' datatype='integer' name='[clues]' role='dimension' type='ordinal' />
            <column-instance column='[clues]' derivation='None' name='[none:clues:ok]' pivot='key' type='ordinal' />
            <column caption='Scanning-only share' datatype='real' name='[scanning_only_share]' role='measure' type='quantitative' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='axis'>
            <format attr='title' class='0' field='[SudokuData].[avg:scanning_only_share:qk]' scope='rows' value='Scanning-only share' />
            <format attr='title' class='0' field='[SudokuData].[none:clues:ok]' scope='cols' value='Number of clues' />
          </style-rule>
          <style-rule element='cell'>
            <format attr='text-format' field='[SudokuData].[avg:scanning_only_share:qk]' value='p0%' />
          </style-rule>
          <style-rule element='worksheet'>
            <format attr='display-field-labels' scope='rows' value='false' />
            <format attr='display-field-labels' scope='cols' value='false' />
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option='selection-relaxation-disallow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Line' />
            <style>
              <style-rule element='mark'>
                <format attr='color' value='#00A3BF' />
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows>[SudokuData].[avg:scanning_only_share:qk]</rows>
        <cols>[SudokuData].[none:clues:ok]</cols>
      </table>
      <simple-id uuid='{68A2263A-2897-427D-9539-8D2F85F33D59}' />
    </worksheet>
  </worksheets>
  <dashboards>
    <dashboard name='Auditing Sudoku Difficulty'>
      <style />
      <size maxheight='720' maxwidth='1100' minheight='720' minwidth='1100' />
      <zones>
        <zone h='100000' id='1' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='8500' id='2' type-v2='text' w='100000' x='0' y='0'>
            <formatted-text>
              <run bold='true' fontcolor='#172b4d' fontsize='22'>Auditing Sudoku Difficulty</run>
              <run fontcolor='#5e6c84' fontsize='11'>
Are clue counts enough to label three million puzzles?</run>
            </formatted-text>
          </zone>
          <zone h='12000' id='3' type-v2='text' w='25000' x='0' y='8500'>
            <formatted-text>
              <run bold='true' fontcolor='#0052cc' fontsize='22'>3.0M</run>
              <run fontcolor='#42526e' fontsize='10'>&#10;validated puzzles</run>
            </formatted-text>
          </zone>
          <zone h='12000' id='4' type-v2='text' w='25000' x='25000' y='8500'>
            <formatted-text>
              <run bold='true' fontcolor='#0052cc' fontsize='22'>0.035</run>
              <run fontcolor='#42526e' fontsize='10'>&#10;clue–rating correlation</run>
            </formatted-text>
          </zone>
          <zone h='12000' id='5' type-v2='text' w='25000' x='50000' y='8500'>
            <formatted-text>
              <run bold='true' fontcolor='#0052cc' fontsize='22'>43.1%</run>
              <run fontcolor='#42526e' fontsize='10'>&#10;scanning-only puzzles</run>
            </formatted-text>
          </zone>
          <zone h='12000' id='6' type-v2='text' w='25000' x='75000' y='8500'>
            <formatted-text>
              <run bold='true' fontcolor='#0052cc' fontsize='22'>2.2%</run>
              <run fontcolor='#42526e' fontsize='10'>&#10;expert-rated puzzles</run>
            </formatted-text>
          </zone>
          <zone h='51500' id='7' name='Difficulty spread by clues' w='63000' x='0' y='20500' />
          <zone h='26500' id='8' name='Catalogue concentration' w='37000' x='63000' y='20500' />
          <zone h='25000' id='9' name='Scanning-only share' w='37000' x='63000' y='47000' />
          <zone h='16500' id='10' type-v2='text' w='100000' x='0' y='72000'>
            <formatted-text>
              <run bold='true' fontcolor='#172b4d' fontsize='12'>Decision: stop using clue count as a difficulty label.</run>
              <run fontcolor='#42526e' fontsize='10'>
Use solving-technique or solver-effort signals for difficulty; keep clue count only as a weak descriptive feature. The clue-only model explains 0.12% of rating variance, while all visible surface features together explain just 0.69%.</run>
            </formatted-text>
          </zone>
